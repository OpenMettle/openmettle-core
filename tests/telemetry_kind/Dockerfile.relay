# Test-only in-cluster OTLP HTTP/1.1 delay relay for tests/telemetry_kind/qualify.py.
# Reuses the exact pinned base images from /Dockerfile; never published or distributed.
FROM rust:1.100.0-slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37 AS build
WORKDIR /src
COPY delay_relay.rs ./
RUN rustc -O --edition 2024 delay_relay.rs -o /usr/local/bin/otlp-delay-relay

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
USER 65532:65532
STOPSIGNAL SIGTERM
COPY --from=build /usr/local/bin/otlp-delay-relay /usr/local/bin/otlp-delay-relay
EXPOSE 9091
ENTRYPOINT ["/usr/local/bin/otlp-delay-relay"]
